//TAKES AN ELEMENT AND PUSH IT IN ITS CORRECT ORDER
void insertion_sort(int n,int arr[]){
    for(int i = 1;i<n;i++){
        //continues checking even after the element has reached its correct position.
        //always goes all the way to j = 1.
        //Which is not needed

        // for(int j=i;j>0;j--){       //Care j=0 bcoz j-1 = -1(when j=0)
        //     if(arr[j] < arr[j-1]){
        //         swap(arr[j],arr[j-1]);
        //     }
        // }

        int j = i;
        while(j > 0 && arr[j] < arr[j-1]){
            swap(arr[j], arr[j-1]);
            j--;
        }
    }
}
int main(){
    int n;
    cin >> n;
    int arr[n];
    for(int i = 0; i < n; i++){
        cin >> arr[i];
    }
    insertion_sort(n,arr);
    for(int i = 0; i < n; i++){
        cout << arr[i] << " ";
    }
    return 0;
